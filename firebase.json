{
  "hosting": {
    "public": "public",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Tesoro AR",
        "supportEmail": "i.unanue@kluppy.com",
        "authorizedRedirectUris": [
          "https://tesoro-ar-app.firebaseapp.com/__/auth/handler",
          "https://tesoro-ar-app.web.app/__/auth/handler"
        ]
      }
    }
  }
}
